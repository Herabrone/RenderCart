# Application
APP_ENV=development
APP_BASE_URL=http://localhost
CADDY_SITE_ADDRESS=:80
SECRET_KEY=dev-only-change-this-to-a-random-secret
ENCRYPTION_KEY=dev-only-change-this-to-a-random-32-byte-key
SUPER_ADMIN_EMAIL=owner@example.com
LOG_LEVEL=INFO

# Local service URLs / credentials (change before deploying)
DATABASE_URL=postgresql+psycopg://rendercart:rendercart@postgres:5432/rendercart
REDIS_URL=redis://redis:6379/0
GPU_METRICS_URL=
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://storage.localhost
S3_PROXY_SITE=http://storage.localhost
S3_ACCESS_KEY=rendercart
S3_SECRET_KEY=rendercart-local-secret
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_RESULTS=results
S3_BUCKET_PERSISTENT=persistent
S3_BUCKET_VAULT=vault
MINIO_ROOT_USER=rendercart
MINIO_ROOT_PASSWORD=rendercart-local-secret
POSTGRES_USER=rendercart
POSTGRES_PASSWORD=rendercart-local-secret
POSTGRES_DB=rendercart

# Optional integrations. Empty values disable the integration.
SENTRY_DSN=
# Self-hosted cookieless analytics. Create a website in Umami, then set its ID.
# Use long, unique alphanumeric secrets in production; do not reuse local defaults.
UMAMI_BASE_URL=http://stats.localhost
UMAMI_CADDY_SITE=http://stats.localhost
UMAMI_WEBSITE_ID=
UMAMI_APP_SECRET=dev-only-change-this-umami-app-secret
UMAMI_DB_PASSWORD=dev-only-change-this-umami-db-password
EMAIL_PROVIDER=mailpit
RESEND_API_KEY=
EMAIL_FROM=RenderCart <noreply@example.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_DAY_PASS=
STRIPE_PRICE_JOB_S=
STRIPE_PRICE_JOB_M=
STRIPE_PRICE_JOB_L=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_1500=
STRIPE_TAX_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AI_MODE=mock
AI_LOCAL_BASE_URL=http://gpu-host:8000/v1
AI_LOCAL_EMBEDDING_BASE_URL=http://gpu-host:8001/v1
AI_LOCAL_API_KEY=
AI_LOCAL_CHAT_MODEL=local-chat
AI_LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
AI_EMBEDDING_DIMENSION=1024
BIREFNET_MODEL_ID=ZhengPeng7/BiRefNet
BIREFNET_MODEL_REVISION=e2bf8e4460fc8fa32bba5ea4d94b3233d367b0e4
TRANSCRIPTION_MODEL_ID=Systran/faster-whisper-large-v3
TRANSCRIPTION_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
DIARIZATION_MODEL_ID=pyannote/speaker-diarization-community-1
DIARIZATION_MODEL_REVISION=3533c8cf8e369892e6b79ff1bf80f7b0286a54ee
# Optional: accept the model card conditions and set an access token to enable speaker diarization.
DIARIZATION_HF_TOKEN=
TTS_MODEL_ID=hexgrad/Kokoro-82M
TTS_MODEL_REVISION=c3327e9bac3dbe55779397bfa82de0f8806fb3bc
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_MONTHLY_SPEND_CAP_USD=25
OPENROUTER_INPUT_COST_PER_MILLION_USD=0.15
OPENROUTER_OUTPUT_COST_PER_MILLION_USD=0.60
GOOGLE_WEB_RISK_API_KEY=
# Set true only when the reverse proxy overwrites CF-IPCountry and direct origin access is blocked.
DYNAMIC_QR_TRUST_COUNTRY_HEADER=false
MAXMIND_LICENSE_KEY=
# Optional paid uptime-monitor SMS alerts. Customers opt in and spend one credit per accepted SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MONITOR_SMS_MONTHLY_CAP=20
RETENTION_GUEST_MIN=60
RETENTION_FREE_MIN=120
RETENTION_PRO_MIN=1440
