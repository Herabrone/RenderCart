# API Configuration
API_KEY_HASH=sha256:your_api_key_hash_here
NO_AUTH=false
BUSINESS_API_KEYS_CONFIG=api/business_keys.json
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
RATE_LIMIT_PER_MINUTE=10
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
MAX_UPLOAD_BYTES=10485760
MAX_BATCH_ITEMS=20
REQUEST_TIMEOUT_SECONDS=30
CALLBACK_TIMEOUT_SECONDS=10

# Cloud Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your-bucket-name

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# HuggingFace
HF_HOME=/cache/huggingface
MODEL_REGISTRY_PATH=configs/model_registry.yaml
PRESET_REGISTRY_PATH=configs/preset_registry.yaml
DEFAULT_MODEL_ID=realvisxl_v4
DEFAULT_PRESET_ID=realvisxl_default

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rendercart
POSTGRES_USER=rendercart
POSTGRES_PASSWORD=rendercart
DATABASE_URL=postgresql+psycopg://rendercart:rendercart@postgres:5432/rendercart

# Shopify Integration
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_SCOPES=write_products,read_products
SHOPIFY_API_VERSION=2024-01
SHOPIFY_ENCRYPTION_KEY=
SHOPIFY_APP_HOST=https://your-app-domain.com
